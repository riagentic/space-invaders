{
  "aioVersion": "v1.0.25-beta",
  "version": "1.0.0",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "aio"
  },
  "imports": {
    "aio": "./dep/aio/mod.ts",
    "aio/air": "./dep/aio/src/air.ts",
    "aio/jsx-runtime": "./dep/aio/src/jsx-runtime.ts",
    "aio/testing": "./dep/aio/src/cell-test.ts",
    "electron": "npm:electron@44.9.3",
    "immer": "npm:immer@10.2.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.3",
    "esbuild": "npm:esbuild@0.25.12"
  },
  "tasks": {
    "dev": "deno run -A --v8-flags=--max-old-space-size=64 src/app.ts",
    "dev:browser": "deno run -A --v8-flags=--max-old-space-size=64 src/app.ts --client=browser",
    "install:electron": "deno install --allow-scripts=npm:electron",
    "test": "deno test -A tests/",
    "cov": "deno test -A --coverage=.coverage tests/ && deno coverage .coverage",
    "am": "deno run -A dep/aio/src/am.ts",
    "e2e": "deno run -A scripts/e2e.ts",
    "difficulty": "deno run -A scripts/difficulty.ts",
    "lint:aio": "deno run -A dep/aio/aiol/mod.ts .",
    "check": "deno check src/app.ts src/App.tsx scripts/ tests/",
    "dev:electron": "deno run -A src/app.ts --client=electron",
    "dev:android": "deno run -A ./dep/aio/src/dev-android.ts",
    "dev:cli": "deno run -A src/app.ts --client=cli",
    "dev:service": "deno run -A src/app.ts --client=server-only",
    "dev:client": "deno run -A src/app.ts --connect",
    "dev:remote:browser": "deno run -A src/app.ts --client=browser --expose",
    "dev:remote:electron": "deno run -A src/app.ts --connect",
    "dev:remote:android": "deno run -A src/app.ts --client=browser --expose",
    "dev:remote:cli": "deno run -A src/client.ts",
    "dev:remote:service": "deno run -A src/app.ts --client=server-only --expose",
    "build": "deno run -A ./dep/aio/src/build-all.ts --build-spec=./dep/aio/src/build.ts",
    "compile": "deno run -A ./dep/aio/src/build.ts --compile",
    "compile:browser": "deno run -A ./dep/aio/src/build.ts --compile",
    "compile:electron": "deno run -A ./dep/aio/src/build.ts --compile --electron",
    "compile:android": "deno run -A ./dep/aio/src/build.ts --android",
    "compile:cli": "deno run -A ./dep/aio/src/build.ts --compile --cli",
    "compile:service": "deno run -A ./dep/aio/src/build.ts --compile --service --headless",
    "compile:client": "deno run -A ./dep/aio/src/build.ts --client",
    "compile:remote:browser": "deno run -A ./dep/aio/src/build.ts --compile --service --remote",
    "compile:remote:electron": "deno run -A ./dep/aio/src/build.ts --compile --service --remote && deno run -A ./dep/aio/src/build.ts --client",
    "compile:remote:android": "deno run -A ./dep/aio/src/build.ts --compile --service --remote && deno run -A ./dep/aio/src/build.ts --android --remote",
    "compile:remote:cli": "deno run -A ./dep/aio/src/build.ts --compile --service --headless --remote && deno run -A ./dep/aio/src/build.ts --compile --cli --remote",
    "compile:remote:service": "deno run -A ./dep/aio/src/build.ts --compile --service --headless --remote",
    "doctor": "deno run -A ./dep/aio/src/server/doctor.ts",
    "lint": "deno run -A ./dep/aio/aiol/mod.ts"
  }
}
